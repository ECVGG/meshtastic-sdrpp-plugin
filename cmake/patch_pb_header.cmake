# patch_pb_header.cmake
# Called as: cmake -DFILE=path/to/xxx.pb.h -P patch_pb_header.cmake
# Inserts #undef guards for Windows macros after the include-guard #define.
# Protobuf-generated headers use classic include guards, not #pragma once.

if(NOT DEFINED FILE)
    message(FATAL_ERROR "FILE variable not set")
endif()

file(READ "${FILE}" content)

# Only patch if not already patched
if(NOT content MATCHES "undef DWORD")
    set(guard
        "// Undefine Windows macros that clash with protobuf enum names\n"
        "#if defined(_WIN32)\n"
        "#  if defined(DWORD)\n#    undef DWORD\n#  endif\n"
        "#  if defined(BYTE)\n#    undef BYTE\n#  endif\n"
        "#  if defined(WORD)\n#    undef WORD\n#  endif\n"
        "#  if defined(BOOL)\n#    undef BOOL\n#  endif\n"
        "#  if defined(ERROR)\n#    undef ERROR\n#  endif\n"
        "#  if defined(OPTIONAL)\n#    undef OPTIONAL\n#  endif\n"
        "#  if defined(NEAR)\n#    undef NEAR\n#  endif\n"
        "#  if defined(FAR)\n#    undef FAR\n#  endif\n"
        "#endif\n"
    )
    string(JOIN "" guard ${guard})

    # Protobuf headers start with:
    #   // Generated by the protocol buffer compiler.  DO NOT EDIT!
    #   ...
    #   #ifndef GOOGLE_PROTOBUF_INCLUDED_...
    #   #define GOOGLE_PROTOBUF_INCLUDED_...   <-- insert after this line
    #
    # Match the #define GOOGLE_PROTOBUF_INCLUDED_ line (with LF or CRLF endings)
    set(patched "${content}")

    # Try CRLF first (Windows)
    string(REGEX REPLACE
        "(#define GOOGLE_PROTOBUF_INCLUDED_[^\r\n]+\r\n)"
        "\\1\n${guard}\n"
        patched "${patched}")

    if(patched STREQUAL content)
        # Try LF (Linux/Mac)
        string(REGEX REPLACE
            "(#define GOOGLE_PROTOBUF_INCLUDED_[^\n]+\n)"
            "\\1\n${guard}\n"
            patched "${patched}")
    endif()

    if(NOT patched STREQUAL content)
        file(WRITE "${FILE}" "${patched}")
        message(STATUS "Patched: ${FILE}")
    else()
        message(WARNING "Could not find GOOGLE_PROTOBUF_INCLUDED_ guard in ${FILE} - not patched")
    endif()
endif()
